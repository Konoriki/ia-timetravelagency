# Fichier de configuration d'exemple
# Copier vers .env.local et remplir les valeurs

# ============================================
# SITE CONFIGURATION
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=TimeTravel Agency
NEXT_PUBLIC_APP_DESCRIPTION=Agence de voyage temporel interactive

# ============================================
# API KEYS (Optionnel)
# ============================================
# Mistral AI (pour chatbot avancé)
# MISTRAL_API_KEY=sk_your_mistral_key_here

# OpenAI (alternative)
# OPENAI_API_KEY=sk_your_openai_key_here

# ============================================
# STRIPE (Pour paiements)
# ============================================
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...

# ============================================
# DATABASE (Optionnel - Future)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost:5432/timetravel

# ============================================
# SUPABASE (Authentification)
# ============================================
# NEXT_PUBLIC_SUPABASE_URL=https://...supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ============================================
# ANALYTICS
# ============================================
# NEXT_PUBLIC_GA_ID=G_XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://...

# ============================================
# ENVIRONMENT
# ============================================
NODE_ENV=development
NEXT_PUBLIC_ENV=development

# ============================================
# Notes:
# - Les variables NEXT_PUBLIC_ sont accessibles au client
# - Les autres sont serveur-only (sécurisé)
# - Ne JAMAIS commiter .env.local sur Git
# - Voir .env.example pour tous les exemples
# ============================================
